# SPA de React: cualquier ruta que no sea un archivo real (o /api, /uploads,
# /data) cae a index.html, y React Router se encarga de mostrar la página.
FallbackResource /index.html

# Apaga el listado de directorios heredado del apache2.conf base (Options
# Indexes FollowSymLinks). Con "-Indexes" se combina con lo ya configurado
# en vez de reemplazarlo, así que FollowSymLinks sigue intacto. Esto aplica
# a todo /var/www/html, incluyendo /api y /uploads, por herencia normal de
# .htaccess salvo que un .htaccess hijo lo reemplace sin +/-.
Options -Indexes

# Headers de seguridad básicos -- no rompen nada (no es un CSP estricto, que
# podría bloquear el widget de Forja o el botón de Google sin darse cuenta).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Refuerza que el navegador SOLO hable con este sitio por HTTPS, incluso
    # si alguien teclea http:// -- Cloudflare ya redirige, esto es una
    # segunda capa a nivel de navegador.
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"

    # Content-Security-Policy: limita de dónde puede cargar scripts, estilos,
    # imágenes y conexiones la página. Aunque alguien lograra colar HTML/JS
    # (XSS), el navegador se niega a ejecutar scripts de dominios no listados.
    # Permitidos: Google Sign-In (accounts.google.com), Google Fonts y el chat
    # de Forja (workers.dev). Sin scripts inline: todo el JS sale de /assets.
    Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com https://forja-restaurante-ladelicia.angelvillota29.workers.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com https://forja-restaurante-ladelicia.angelvillota29.workers.dev; frame-src https://accounts.google.com https://forja-restaurante-ladelicia.angelvillota29.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Archivos de despliegue/configuración que nunca deben descargarse por la web
# (antes /entrypoint.sh se podía bajar tal cual desde cualquier navegador).
<FilesMatch "\.(sh|ini|md|dockerfile)$|^Dockerfile$">
    Require all denied
</FilesMatch>
