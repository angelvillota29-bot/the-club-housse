# Datos reales del restaurante (pedidos, menú, contraseñas) e imágenes
# subidas -- viven en volúmenes persistentes de Easypanel, nunca en el
# repositorio. Si alguna vez corres esto localmente, esto evita subirlos
# sin querer.
/data/
/uploads/*
!/uploads/.gitkeep

# Basura común de editor / sistema operativo
.DS_Store
Thumbs.db

# Build de la SPA de React
node_modules/
dist/

# Skill de Impeccable (herramienta local, se reinstala igual que ui-ux-pro-max)
.claude/skills/impeccable/
.claude/agents/
